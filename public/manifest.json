{
  "name": "PRISM Search & Safari Browser",
  "short_name": "PRISM",
  "description": "Hybrid Google Search and Safari Web Browser with Animated Flowcharts, Data Tables, and Deep-Dive Intelligence.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b14",
  "theme_color": "#0f172a",
  "categories": ["utilities", "productivity", "news"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/prism-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Search",
      "short_name": "Search",
      "description": "Open PRISM Omnisearch",
      "url": "/?action=search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Research Workbench",
      "short_name": "Workbench",
      "description": "Open your research dossier",
      "url": "/?action=workbench",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=ai.prism.browser",
      "id": "ai.prism.browser"
    }
  ]
}
